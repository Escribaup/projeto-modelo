{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "projeto-modelo": {
      "source": { "source": "github", "repo": "Escribaup/projeto-modelo" }
    }
  },
  "enabledPlugins": {
    "guia-vivo@projeto-modelo": true
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.prod)",
      "Read(.env.production)",
      "Read(.env.producao)",
      "Read(.env.development)",
      "Read(.env.homologacao)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.prod)",
      "Edit(.env.production)",
      "Edit(.env.producao)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.key)",
      "Read(**/credentials*.json)",
      "Read(**/service-account*.json)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)"
    ]
  }
}
