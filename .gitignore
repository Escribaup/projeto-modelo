# Senhas e chaves: nunca vão para o git
.env
.env.*
!.env.exemplo
!.env.example

# Certificados digitais (A1) e chaves de acesso
*.pfx
*.p12
*.key
*.pem
credentials*.json
service-account*.json
id_rsa*
id_ed25519*

# Dados reais de clientes: nunca vão para o git
# Guarde planilhas, extratos, notas e relatórios reais em dados-locais/
dados-locais/
*.xlsx
*.xls
*.xlsm
*.ods
*.csv
*.ofx
*.pdf
# Exceção: dados FICTÍCIOS de teste e exemplos podem ir ao git
!tests/**
!exemplos/**

# Configurações pessoais do Claude Code (as do projeto ficam em .claude/settings.json)
.claude/settings.local.json

# Sistema operacional e editores
.DS_Store
Thumbs.db
*.swp
*~

# Dependências e arquivos gerados
node_modules/
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
*.log
